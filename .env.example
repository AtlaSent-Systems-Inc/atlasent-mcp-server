# AtlaSent MCP Server — Environment Configuration
# Copy this file to .env and fill in values before running.
# Never commit .env to source control.

# ─── Mode ─────────────────────────────────────────────────────────────────────────
# Engine mode — read by getMode() in src/engine.ts on every call:
#   ATLASENT_MODE=remote  → hosted AtlaSent API
#   ATLASENT_MODE=local   → in-process rules engine (no network)
#   (unset)               → remote if ATLASENT_API_KEY and
#                            ATLASENT_BASE_URL are both set, else local
ATLASENT_MODE=local

# ─── Remote Mode ───────────────────────────────────────────────────────────────────────
# Required when ATLASENT_MODE=remote

# Your AtlaSent API key. Obtain from the AtlaSent operator console → API Keys.
ATLASENT_API_KEY=ask_live_YOUR_KEY_HERE

# Base URL for the AtlaSent edge functions.
ATLASENT_BASE_URL=https://<project-ref>.supabase.co/functions/v1

# ─── Read-only mode (recommended for live demos) ────────────────────────────────────────────────────────
# Set to 1 (or true) to skip registration of the 7 mutating CRUD tools
# (create/update/delete policy, create/delete webhook, revoke/issue permit).
# Strongly recommended whenever the server is pointed at a live API key,
# so an adversarial prompt cannot destroy real policies or revoke permits.
# ATLASENT_MCP_READONLY=1

# ─── Rate limiting ───────────────────────────────────────────────────────────────────
# Per-tool token bucket. Caps the calls-per-second any single tool
# handler can sustain. Default: 600 calls per minute.
# ATLASENT_MCP_RATE_LIMIT=600

# ─── Evaluation Defaults ────────────────────────────────────────────────────────────────────
# Default actor identity to use when the MCP tool call does not specify one.
# Leave empty to require explicit actor on every call.
ATLASENT_DEFAULT_ACTOR=

# Fail-closed behavior: if true, evaluation errors return deny instead of allow.
# Recommended: true for production. Default: true.
ATLASENT_FAIL_CLOSED=true

# ─── Logging ─────────────────────────────────────────────────────────────────────────────
# Log level: debug | info | warn | error
ATLASENT_LOG_LEVEL=info
