# AtlaSent MCP Server — Environment Configuration
# Copy this file to .env and fill in values before running.
# Never commit .env to source control.

# ─── Mode ──────────────────────────────────────────────────────────────
# Engine mode — read by getMode() in src/engine.ts on every call:
#   ATLASENT_MODE=remote  → hosted AtlaSent API (Maturity: GA)
#   ATLASENT_MODE=local   → in-process rules engine (Maturity: Experimental)
#   (unset)               → remote if ATLASENT_API_KEY and
#                            ATLASENT_BASE_URL are both set, else local
#
# Maturity classification per atlasent/MATURITY_DOCTRINE.md (adopted 2026-05-26):
#   - remote mode: GA. Permits signed server-side; audit-chain-bound.
#   - local mode:  Experimental. Permits are UNSIGNED and forgeable
#                  (Date.now() + UUID slice). Development and CI only.
#
# In local mode, the engine emits a one-time stderr warning at first
# authorize()/verify() call. Set ATLASENT_SUPPRESS_LOCAL_MODE_WARNING=true
# to silence the warning in dev/CI scripts where it is noise.
#
# The engine refuses to resolve to local mode under NODE_ENV=production
# unless ATLASENT_ALLOW_LOCAL_MODE_IN_PROD=true (NOT RECOMMENDED).
# See SECURITY.md "Maturity classification" for the full posture.
ATLASENT_MODE=local

# ─── Remote Mode ───────────────────────────────────────────────────────────
# Required when ATLASENT_MODE=remote

# Your AtlaSent API key. Obtain from the AtlaSent operator console → API Keys.
ATLASENT_API_KEY=ask_live_YOUR_KEY_HERE

# Base URL for the AtlaSent edge functions.
ATLASENT_BASE_URL=https://<project-ref>.supabase.co/functions/v1

# ─── Read-only mode (recommended for live demos) ──────────────────────────────────────────
# Set to 1 (or true) to skip registration of the 7 mutating CRUD tools
# (create/update/delete policy, create/delete webhook, revoke/issue permit).
# Strongly recommended whenever the server is pointed at a live API key,
# so an adversarial prompt cannot destroy real policies or revoke permits.
# ATLASENT_MCP_READONLY=1

# ─── Rate limiting ──────────────────────────────────────────────────────────
# Per-tool token bucket. Caps the calls-per-second any single tool
# handler can sustain. Default: 600 calls per minute.
# ATLASENT_MCP_RATE_LIMIT=600

# ─── Evaluation Defaults ──────────────────────────────────────────────────────────
# Default actor identity to use when the MCP tool call does not specify one.
# Leave empty to require explicit actor on every call.
ATLASENT_DEFAULT_ACTOR=

# Fail-closed behavior: if true, evaluation errors return deny instead of allow.
# Recommended: true for production. Default: true.
ATLASENT_FAIL_CLOSED=true

# ─── Behavior Conditioning (C.MCP1) ──────────────────────────────────────────────────
# When set, each batch evaluate item is enriched with bvsSnapshot from behavior-insights
# before forwarding. Both variables must be set for enrichment to activate.
# Enrichment is fail-open: items are forwarded unchanged if the service is unavailable.
# ATLASENT_BEHAVIOR_BASE_URL=https://<behavior-insights-host>
# ATLASENT_BEHAVIOR_API_KEY=<service-api-key>

# ─── Logging ──────────────────────────────────────────────────────────────────
# Log level: debug | info | warn | error
ATLASENT_LOG_LEVEL=info

# ─── Maturity warning suppression (dev/CI only) ────────────────────────────────────────
# When ATLASENT_MODE=local, the engine emits a one-time stderr warning at
# first authorize()/verify() call (see SECURITY.md "Maturity classification").
# In CI scripts where the warning is noise, set this to true to silence it.
# DO NOT set this in production. Local mode is already refused under
# NODE_ENV=production unless ATLASENT_ALLOW_LOCAL_MODE_IN_PROD=true.
# ATLASENT_SUPPRESS_LOCAL_MODE_WARNING=true
