{
  "name": "@atlasent/mcp-server",
  "version": "1.0.0",
  "description": "Add AtlaSent governance to any MCP-compatible AI agent. Evaluate actions before execution, verify permits after — fail-closed by default.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "atlasent-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node --test dist/server.test.js",
    "test:integration": "node --test dist/integration.test.js",
    "demo": "node examples/demo.mjs",
    "start": "node dist/index.js",
    "prepare": "tsc"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AtlaSent-Systems-Inc/mcp-server.git"
  },
  "homepage": "https://github.com/AtlaSent-Systems-Inc/mcp-server#readme",
  "bugs": {
    "url": "https://github.com/AtlaSent-Systems-Inc/mcp-server/issues"
  },
  "keywords": [
    "mcp",
    "atlasent",
    "model-context-protocol",
    "ai-safety",
    "ai-governance",
    "policy-evaluation",
    "claude",
    "cursor",
    "copilot",
    "langchain"
  ],
  "author": "AtlaSent Systems Inc.",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^6.0.2"
  }
}
