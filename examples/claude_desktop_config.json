{
  "_comment": "Claude Desktop MCP server configuration for @atlasent/mcp-server (v2).",
  "_docs": "https://github.com/AtlaSent-Systems-Inc/atlasent-mcp-server#readme",

  "mcpServers": {
    "atlasent": {
      "command": "npx",
      "args": ["-y", "@atlasent/mcp-server"],
      "env": {
        "ATLASENT_API_URL": "https://api.atlasent.io",
        "ATLASENT_API_KEY": "<your-atlasent-api-key>"
      }
    }
  }
}
